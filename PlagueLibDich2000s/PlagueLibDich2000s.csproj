<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      FIX BUILD-02: DLL thật của game (Assembly-CSharp, UnityEngine.CoreModule,
      UnityEngine.AssetBundleModule, UnityEngine.TextRenderingModule...) được build
      nhắm netstandard 2.1 (Unity phiên bản game đang dùng hỗ trợ profile này) —
      target netstandard2.0 cũ của project thấp hơn, gây CS1705 "has a higher
      version than referenced assembly netstandard". Nâng lên 2.1 để khớp đúng
      những gì các DLL tham chiếu thật sự yêu cầu.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PlagueLibDich2000s</AssemblyName>
    <RootNamespace>PlagueLibDich2000s</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    Đường dẫn tới BepInEx và tới thư mục Managed của game KHÔNG được hardcode ở đây,
    vì mỗi máy dev cài game/BepInEx ở một ổ đĩa/thư mục khác nhau.
    Chúng được nạp từ Directory.Build.props (ở thư mục gốc repo), file đó lại đọc từ
    Directory.Build.props.user (không commit, mỗi máy tự tạo) hoặc từ biến môi trường
    hệ thống BepInExDir / GameManagedDir. Xem SETUP.md để biết cách cấu hình máy bạn.
  -->
  <Target Name="CheckDevPaths" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(BepInExDir)' == ''" Text="BepInExDir chưa được cấu hình. Xem SETUP.md ở gốc repo — tạo file Directory.Build.props.user hoặc set biến môi trường BepInExDir." />
    <Error Condition="'$(GameManagedDir)' == ''" Text="GameManagedDir chưa được cấu hình. Xem SETUP.md ở gốc repo — tạo file Directory.Build.props.user hoặc set biến môi trường GameManagedDir." />
  </Target>

  <!--
    FIX BUILD-01: các HintPath dưới đây TRƯỚC ĐÂY bị hardcode cứng đường dẫn tương đối
    riêng của máy tác giả gốc (vd "..\..\..\..\..\plagueinc\Plague.Inc.Evolved...",
    "..\..\..\..\..\steam\steamapps\..."), mâu thuẫn với chính comment phía trên nói
    là lấy từ Directory.Build.props — nên trên MÁY KHÁC, dù Directory.Build.props.user
    đã đúng và được nạp (CheckDevPaths không báo lỗi vì $(BepInExDir)/$(GameManagedDir)
    có giá trị), HintPath vẫn trỏ sai chỗ vì chưa từng thực sự dùng 2 biến đó. Giờ mọi
    HintPath dùng $(BepInExDir)/$(GameManagedDir) thật sự — đúng như thiết kế ban đầu.
  -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\AboutMod.png" />
  </ItemGroup>

  <!--
    Cài mod tự động sau khi build: copy DLL vừa build vào
    <BepInExDir>\plugins\PlagueLibDich2000s\ để test ngay trong game.
    Chỉ chạy khi BepInExDir đã được cấu hình (đã Error ở CheckDevPaths nếu chưa, nên
    tới bước này BepInExDir chắc chắn có giá trị). Có thể tắt bằng cách build với
    /p:SkipInstallToBepInEx=true (ví dụ khi build trên CI, không có BepInEx thật).
  -->
  <PropertyGroup>
    <PluginInstallDir>$(BepInExDir)\plugins\PlagueLibDich2000s\</PluginInstallDir>
  </PropertyGroup>

  <Target Name="InstallToBepInEx" AfterTargets="Build" Condition="'$(SkipInstallToBepInEx)' != 'true'">
    <MakeDir Directories="$(PluginInstallDir)" Condition="!Exists('$(PluginInstallDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginInstallDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(PluginInstallDir)" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[PlagueLibDich2000s] Đã cài vào: $(PluginInstallDir)$(AssemblyName).dll" />
  </Target>

</Project>