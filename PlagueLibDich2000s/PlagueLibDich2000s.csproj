<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>PlagueLibDich2000s</AssemblyName>
    <RootNamespace>PlagueLibDich2000s</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    Đường dẫn tới BepInEx và tới thư mục Managed của game KHÔNG được hardcode ở đây,
    vì mỗi máy dev cài game/BepInEx ở một ổ đĩa/thư mục khác nhau.
    Chúng được nạp từ Directory.Build.props (ở thư mục gốc repo), file đó lại đọc từ
    Directory.Build.props.user (không commit, mỗi máy tự tạo) hoặc từ biến môi trường
    hệ thống BepInExDir / GameManagedDir. Xem SETUP.md để biết cách cấu hình máy bạn.
  -->
  <Target Name="CheckDevPaths" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(BepInExDir)' == ''" Text="BepInExDir chưa được cấu hình. Xem SETUP.md ở gốc repo — tạo file Directory.Build.props.user hoặc set biến môi trường BepInExDir." />
    <Error Condition="'$(GameManagedDir)' == ''" Text="GameManagedDir chưa được cấu hình. Xem SETUP.md ở gốc repo — tạo file Directory.Build.props.user hoặc set biến môi trường GameManagedDir." />
  </Target>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\..\..\..\..\plagueinc\Plague.Inc.Evolved.v1.24.0.3.ALL.DLC\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\..\..\..\plagueinc\Plague.Inc.Evolved.v1.24.0.3.ALL.DLC\PlagueIncEvolved_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\..\..\..\..\steam\steamapps\common\PlagueInc\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\..\..\..\steam\steamapps\common\PlagueInc\PlagueIncEvolved_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>




    <Reference Include="UnityEngine.AIModule">
      <HintPath>..\..\..\..\..\steam\steamapps\common\PlagueInc\PlagueIncEvolved_Data\Managed\UnityEngine.AIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>




    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>..\..\..\..\..\plagueinc\Plague.Inc.Evolved.v1.24.0.3.ALL.DLC\PlagueIncEvolved_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>




    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\..\..\plagueinc\Plague.Inc.Evolved.v1.24.0.3.ALL.DLC\PlagueIncEvolved_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>




    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\..\..\..\..\plagueinc\Plague.Inc.Evolved.v1.24.0.3.ALL.DLC\PlagueIncEvolved_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>




    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\..\..\..\..\plagueinc\Plague.Inc.Evolved.v1.24.0.3.ALL.DLC\PlagueIncEvolved_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\AboutMod.png" />
  </ItemGroup>

  <!--
    Cài mod tự động sau khi build: copy DLL vừa build vào
    <BepInExDir>\plugins\PlagueLibDich2000s\ để test ngay trong game.
    Chỉ chạy khi BepInExDir đã được cấu hình (đã Error ở CheckDevPaths nếu chưa, nên
    tới bước này BepInExDir chắc chắn có giá trị). Có thể tắt bằng cách build với
    /p:SkipInstallToBepInEx=true (ví dụ khi build trên CI, không có BepInEx thật).
  -->
  <PropertyGroup>
    <PluginInstallDir>$(BepInExDir)\plugins\PlagueLibDich2000s\</PluginInstallDir>
  </PropertyGroup>

  <Target Name="InstallToBepInEx" AfterTargets="Build" Condition="'$(SkipInstallToBepInEx)' != 'true'">
    <MakeDir Directories="$(PluginInstallDir)" Condition="!Exists('$(PluginInstallDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginInstallDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(PluginInstallDir)" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[PlagueLibDich2000s] Đã cài vào: $(PluginInstallDir)$(AssemblyName).dll" />
  </Target>

</Project>
